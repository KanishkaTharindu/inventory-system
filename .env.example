# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) allowed to POST when behind a proxy, e.g. https://stock.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Colombo

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=office_stock
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# PostgreSQL TLS mode. Production should use require or verify-full; set prefer for an unencrypted local Postgres.
DB_SSLMODE=require
DB_SSLROOTCERT=

# Secret for the scheduled 30-day cleanup: POST /maintenance/stock-ledger-retention/ with header "Authorization: Bearer <this value>"
CRON_SECRET=

# For multiple web workers, set database and run `python manage.py createcachetable` once.
DJANGO_CACHE_BACKEND=locmem

# Production HTTPS settings. Enable HSTS only after HTTPS works on every served hostname.
# Keep false for local HTTP development. Set true on the production HTTPS host.
DJANGO_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Set true only when a trusted proxy overwrites X-Forwarded-Proto before forwarding the request.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Used by `python manage.py seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
# At least 12 characters; avoid common passwords and your name/email.
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Our Company
