# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) allowed to POST when behind a proxy, e.g. https://stock.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Colombo

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=office_stock
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Secret for the scheduled 30-day cleanup: GET /maintenance/stock-ledger-retention/ with header "Authorization: Bearer <this value>"
CRON_SECRET=

# Used by `python manage.py seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Our Company
